# ── App ───────────────────────────────────────────────
DEBUG=false

# ── AWS ───────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── PostgreSQL ────────────────────────────────────────
DB_URL=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_db

# ── MLflow ────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection

# ── S3 ────────────────────────────────────────────────
S3_BUCKET=fraud-detection-models

# ── Kafka ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Thresholds ────────────────────────────────────────
FRAUD_BLOCK_THRESHOLD=0.72
FRAUD_REVIEW_THRESHOLD=0.40
DRIFT_PSI_THRESHOLD=0.05
